# GSD planning docs kept local-only
.planning/

# Environment secrets — never commit real .env
.env

# Flutter --dart-define-from-file payloads: hold the real Yandex map key
mobile/dart_define.json
mobile/dart_define.*.json

# Same key, exposed to the intro which runs before Flutter boots and therefore
# cannot read a --dart-define value.
mobile/web/map_key.js

# Node
node_modules/
dist/

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Obsidian personal UI state (vault notes ARE committed)
avto/.obsidian/

# Grill/plan-review workflow artifacts — not project files
PLAN.md
PLAN-REVIEW-LOG.md

# Local assistant plugins/config — not project files
.claude/

# Belt-and-suspenders Flutter/Android/iOS artifacts (mobile/.gitignore is primary)
mobile/build/
mobile/.dart_tool/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
**/Flutter/ephemeral/
**/*.iml
