<?xml version="1.0" encoding="utf-8"?>
<!--
  Launch window for API 21+.

  Was `?android:colorBackground`, which follows the phone's day/night setting —
  white on a phone in light mode. This app has only a dark theme, so the launch
  window is pinned to the same surface colour the first Flutter frame paints.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/avto_surface" />
</layer-list>
