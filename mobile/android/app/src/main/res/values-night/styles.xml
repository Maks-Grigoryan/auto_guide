<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Identical to values/styles.xml on purpose. The app has one dark theme, so
      launch must look the same whether or not the phone is in night mode; this
      file exists only because Android would otherwise fall back to its own
      night defaults.
    -->
    <style name="LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/avto_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/avto_surface</item>
    </style>
</resources>
