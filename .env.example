# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL container password (used by docker-compose.yml)
POSTGRES_PASSWORD=autoapp

# Full database connection URL consumed by NestJS backend and node-pg-migrate
DATABASE_URL=postgres://autoapp:autoapp@localhost:5432/autoapp

# Comma-separated browser origins. Native mobile clients do not require CORS.
CORS_ORIGINS=http://localhost:8080

# Optional pool/host settings.
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# --- AI assistant: read-only database access -------------------------------
# The assistant reaches the catalogue through a separate PostgreSQL role that
# holds SELECT on nine catalogue tables and nothing else. users,
# pending_registrations and the chat history are never granted to it.
#
# Password for that role. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# If left empty, migration 015 succeeds as a no-op (role not created) — fine
# for environments without the assistant.
AI_DB_PASSWORD=

# Same database as DATABASE_URL, connected as ai_readonly. Only the
# credentials differ — host, port and database name stay the same.
AI_DATABASE_URL=postgres://ai_readonly:CHANGE_ME@localhost:5432/autoapp

# --- AI assistant: language model ------------------------------------------
# Any OpenAI-compatible endpoint: a hosted open-weight provider (DeepInfra,
# Together, Fireworks) or your own vLLM. Swapping one for the other is these
# three lines, not a code change.
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
LLM_API_KEY=
LLM_MODEL=

# Cheap model that answers one question before the expensive one runs: is this
# about cars? Keeps off-topic questions from costing real money.
LLM_CLASSIFIER_MODEL=

# Messages one account may send per day. The ceiling that stops a script from
# spending your balance overnight.
AI_DAILY_MESSAGE_LIMIT=50
