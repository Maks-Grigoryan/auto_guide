# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL container password (used by docker-compose.yml)
POSTGRES_PASSWORD=autoapp

# Full database connection URL consumed by NestJS backend and node-pg-migrate
DATABASE_URL=postgres://autoapp:autoapp@localhost:5432/autoapp

# Comma-separated browser origins. Native mobile clients do not require CORS.
CORS_ORIGINS=http://localhost:8080

# Optional pool/host settings.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
